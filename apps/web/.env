# Public origin of the deployed site, no trailing slash. Used for absolute link-preview URLs
# in index.html (og:url, og:image).
VITE_SITE_URL=https://macstats.luizcastro.dev

# Umami analytics. Leave empty to disable tracking (e.g. local dev).
# Script URL is https://cloud.umami.is/script.js on Umami Cloud, or https://<your-umami-host>/script.js self-hosted.
VITE_UMAMI_SCRIPT_URL=https://umami.luizcastro.dev/script.js
VITE_UMAMI_WEBSITE_ID=2850a466-014d-4b6b-89f7-aacb216a7f69
